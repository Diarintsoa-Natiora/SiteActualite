Options +FollowSymlinks
RewriteEngine On

# URL SEO test: /actualites/slug-123-5.html
RewriteRule ^actualites/([a-z0-9-]+)-([0-9]+)-([0-9]+)\.html$ pages/article.php?slug=$1&id=$2&idcat=$3 [L,QSA,NC]

# Page d'inscription : /inscription
RewriteRule ^inscription$ pages/register.php [L,QSA,NC]

# Connexion / déconnexion
RewriteRule ^connexion$ pages/login.php [L,QSA,NC]
RewriteRule ^deconnexion$ pages/logout.php [L,QSA,NC]

# Espace utilisateur et site public
RewriteRule ^bienvenue$ pages/welcome.php [L,QSA,NC]
RewriteRule ^site$ pages/site.php [L,QSA,NC]
RewriteRule ^redaction$ pages/backoffice_article.php [L,QSA,NC]
RewriteRule ^backoffice$ pages/backoffice_articles.php [L,QSA,NC]


# Fallback to home page
RewriteRule ^$ pages/home.php [L]

# --- Compression gzip/brotli ---
<IfModule mod_deflate.c>
	# Active la compression gzip standard
	AddOutputFilterByType DEFLATE \
		text/html text/plain text/xml text/css text/javascript application/javascript \
		application/json application/xml application/rss+xml application/atom+xml \
		application/vnd.ms-fontobject application/x-font-ttf font/opentype image/svg+xml

	# Compatibilité anciens navigateurs
	BrowserMatch ^Mozilla/4 gzip-only-text/html
	BrowserMatch ^Mozilla/4\.0[678] no-gzip
	BrowserMatch \bMSIE !no-gzip !gzip-only-text/html
</IfModule>

<IfModule mod_brotli.c>
	AddOutputFilterByType BROTLI_COMPRESS \
		text/html text/plain text/xml text/css text/javascript application/javascript \
		application/json application/xml application/rss+xml application/atom+xml \
		application/vnd.ms-fontobject application/x-font-ttf font/opentype image/svg+xml
</IfModule>

<IfModule mod_headers.c>
	Header append Vary Accept-Encoding
</IfModule>

# --- Caching côté client ---
<IfModule mod_expires.c>
	ExpiresActive On

	# Static assets: long cache + immutable
	ExpiresByType text/css "access plus 30 days"
	ExpiresByType application/javascript "access plus 30 days"
	ExpiresByType text/javascript "access plus 30 days"
	ExpiresByType image/png "access plus 30 days"
	ExpiresByType image/jpeg "access plus 30 days"
	ExpiresByType image/webp "access plus 30 days"
	ExpiresByType image/avif "access plus 30 days"
	ExpiresByType image/svg+xml "access plus 30 days"
	ExpiresByType font/woff2 "access plus 30 days"
	ExpiresByType font/woff "access plus 30 days"
	ExpiresByType application/font-woff2 "access plus 30 days"

	# HTML: short cache to stay fresh
	ExpiresByType text/html "access plus 1 minute"
</IfModule>

<IfModule mod_headers.c>
	# Static assets (served from /assets/) get long cache
	<FilesMatch "\.(?:css|js|png|jpe?g|webp|avif|svg|woff2?)$">
		Header set Cache-Control "public, max-age=2592000, immutable"
	</FilesMatch>

	# HTML/PHP stay short-lived
	<FilesMatch "\.php$">
		Header set Cache-Control "no-cache, no-store, must-revalidate"
	</FilesMatch>
</IfModule>

# Fallback to site vitrine
RewriteRule ^$ pages/site.php [L]

